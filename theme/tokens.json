{
  "theme": {
    "name": "arctic-glacier-blue",
    "label": "北极冰山 · 深邃蓝",
    "description": "TDev 官方 UI 主题：深邃冰蓝 + 冰面中性色，冷静、澄澈、克制。",
    "version": "1.0.0"
  },
  "colors": {
    "primary": {
      "900": "#072B4E",
      "700": "#0A4D8C",
      "500": "#1A6CB3",
      "300": "#5C9FD6",
      "100": "#C9E2F5",
      "050": "#E8F3FB"
    },
    "neutral": {
      "ink900": "#102A43",
      "ink700": "#334E68",
      "ink500": "#627D98",
      "ink300": "#9FB3C8",
      "line300": "#D2E0EC",
      "bg": "#F4F8FC",
      "surface": "#FFFFFF",
      "surfaceSunken": "#EAF2FA"
    },
    "semantic": {
      "success": "#2E9E6B",
      "warning": "#D9822B",
      "danger": "#D64545",
      "info": "#1A6CB3"
    }
  },
  "typography": {
    "fontFamily": "\"Segoe UI\", \"Microsoft YaHei\", system-ui, sans-serif",
    "monospace": "Consolas, monospace",
    "lineHeight": { "body": 1.5, "heading": 1.3 },
    "sizes": {
      "text-xs": 12,
      "text-sm": 14,
      "text-base": 16,
      "text-lg": 20,
      "text-xl": 24,
      "text-2xl": 32
    },
    "weights": { "regular": 400, "semi": 600, "bold": 700 }
  },
  "spacing": {
    "unit": 4,
    "steps": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
    "cardPadding": 16,
    "cardPaddingLg": 24,
    "pagePadding": 24,
    "maxContentWidth": 1080,
    "controlGap": 8,
    "groupGap": 24,
    "sectionGap": 32
  },
  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 8,
    "xl": 12
  },
  "shadows": {
    "sm": "0 1px 2px rgba(7,43,78,.08)",
    "md": "0 2px 8px rgba(7,43,78,.10)",
    "lg": "0 8px 24px rgba(7,43,78,.16)"
  },
  "components": {
    "button": {
      "height": { "small": 24, "medium": 32, "large": 40 },
      "radius": "md",
      "primary": { "bg": "#0A4D8C", "text": "#FFFFFF", "hoverBg": "#072B4E", "focusRing": "#1A6CB3" },
      "secondary": { "bg": "#FFFFFF", "border": "#D2E0EC", "text": "#102A43", "hoverBorder": "#1A6CB3" }
    },
    "input": {
      "height": 32,
      "radius": "md",
      "border": "#D2E0EC",
      "focusBorder": "#1A6CB3",
      "focusRing": "rgba(26,108,179,.25)",
      "placeholder": "#627D98"
    },
    "table": {
      "headerBg": "#E8F3FB",
      "headerText": "#334E68",
      "rowHeight": 40,
      "rowBorder": "#D2E0EC",
      "hoverRowBg": "#E8F3FB",
      "selectedRowBg": "#C9E2F5"
    },
    "sidebar": {
      "width": 240,
      "activeBg": "#E8F3FB",
      "activeIndicator": "#0A4D8C",
      "hoverBg": "#E8F3FB"
    },
    "topbar": {
      "height": 56,
      "bg": "#FFFFFF",
      "borderBottom": "#D2E0EC"
    },
    "card": {
      "bg": "#FFFFFF",
      "radius": "lg",
      "shadow": "sm",
      "border": "#D2E0EC"
    },
    "modal": {
      "bg": "#FFFFFF",
      "radius": "xl",
      "shadow": "lg",
      "overlay": "rgba(16,42,67,.45)"
    }
  },
  "motion": {
    "duration": { "state": 150, "reveal": 250 },
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "rules": {
    "primaryBase": "#0A4D8C",
    "maxPrimarySharePercent": 15,
    "forbidPureBlack": true,
    "contrastBodyMin": "4.5:1",
    "spacingUnit": 4,
    "maxEmphasisColors": 2
  }
}
