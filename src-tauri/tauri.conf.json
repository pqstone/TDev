{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TDev",
  "version": "0.1.0",
  "identifier": "com.tdev.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TDev 桌面应用",
        "width": 1400,
        "height": 720,
        "resizable": true,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
